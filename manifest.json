{
  "manifest_version": 3,
  "name": "划词翻译",
  "version": "0.0.1",
  "description": "选中单词后快速翻译",
  "permissions": ["activeTab"],
  "icons": {
    "16": "src/assets/icon/icon_16x16.png",
    "48": "src/assets/icon/icon_48x48.png",
    "128": "src/assets/icon/icon_128x128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "划词翻译"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_end"
    }
  ]
}
